# Purpose: run Vyasa Reader with Gunicorn on 127.0.0.1:8000 as the non-root "vyasa" user; restart on failure and start at boot.
[Unit]
Description=Vyasa Reader (Gunicorn)
After=network.target

[Service]
User=vyasa
Group=vyasa
WorkingDirectory=/opt/vyasa-reader
ExecStart=/opt/vyasa-reader/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --access-logfile - app:app
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
